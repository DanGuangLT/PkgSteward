{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^execa$": "<rootDir>/mocks/execa.ts"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
