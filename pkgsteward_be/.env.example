# =============================================================================
# PkgSteward Backend Environment Variables
# =============================================================================

# Chế độ chạy: development hoặc production
MODE="development"

# Host và Port chạy local
HOST="localhost"
PORT=24681

# Tiền tố và phiên bản API (URL dạng: http://localhost:24681/api/v1)
GLOBAL_PREFIX="api"
VERSION="1"

# Danh sách Origin được phép truy cập CORS (URL của frontend Next.js)
LIST_ORIGIN_CORS="http://localhost:24680"

# Xuất Swagger API spec ra docs_API/swagger.json khi chạy dev
EXPORT_SWAGGER_API_JSON=true

# Đường dẫn thư mục gốc để scan tìm dự án Node.js/npm (phân cách bằng dấu phẩy nếu nhiều path)
# Ví dụ: "D:\Coding,C:\Users\username\Projects"
# Đặt "*" để quét TOÀN BỘ ổ đĩa cố định của máy (bỏ qua thư mục hệ thống) và quản lý mọi project npm/pnpm/yarn có trên máy.
# Muốn thu hẹp phạm vi (quét nhanh hơn) thì liệt kê thư mục cụ thể.
SCAN_ROOT_PATHS="*"

# Giới hạn độ sâu khi quét cây thư mục (tính từ mỗi thư mục gốc; với "*" là từ gốc mỗi ổ đĩa)
MAX_SCAN_DEPTH=4

# Giới hạn thời gian (ms) khi chạy lệnh npm/pnpm/yarn (mặc định 6 phút)
NPM_COMMAND_TIMEOUT_MS=360000
