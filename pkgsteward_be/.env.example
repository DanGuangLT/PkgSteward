# =============================================================================
# PkgSteward Backend Environment Variables
# =============================================================================

# Chế độ chạy: development hoặc production
MODE="development"

# Host và Port chạy local (HOST chỉ nhận loopback: 127.0.0.1, localhost hoặc ::1)
HOST="127.0.0.1"
PORT=24681

# Tiền tố và phiên bản API (URL dạng: http://localhost:24681/api/v1)
GLOBAL_PREFIX="api"
VERSION="1"

# Danh sách Origin được phép truy cập CORS (URL của frontend Next.js)
LIST_ORIGIN_CORS="http://localhost:24680"

# Xuất Swagger API spec ra docs_API/swagger.json khi chạy dev
EXPORT_SWAGGER_API_JSON=true

# Đường dẫn thư mục gốc (tuyệt đối) để scan tìm dự án Node.js/npm (phân cách bằng dấu phẩy nếu nhiều path)
# Ví dụ: "D:\Coding,C:\Users\username\Projects". "*" hoặc để trống = mọi ổ đĩa cố định ("*" phải đứng một mình)
SCAN_ROOT_PATHS="*"

# Giới hạn độ sâu khi quét cây thư mục, tính từ mỗi thư mục gốc (với "*" là từ gốc mỗi ổ đĩa)
# 0 = không giới hạn (mặc định): tìm được cả project nằm sâu, rải rác khắp máy
MAX_SCAN_DEPTH=0

# Giới hạn thời gian (ms) cho một lần quét. Để trống = không giới hạn (mặc định), quét đến khi xong; nếu đặt thì tối thiểu 1000
SCAN_TIMEOUT_MS=

# Giới hạn thời gian (ms) khi chạy lệnh npm/pnpm/yarn (mặc định 6 phút)
NPM_COMMAND_TIMEOUT_MS=360000

# Thư mục dữ liệu runtime (log, cache, settings.json): đường dẫn tuyệt đối, hoặc tương đối tính từ thư mục gốc dự án
# Để trống = "PkgStewardLog" (thư mục PkgStewardLog trong thư mục dự án). settings.json trong thư mục này ghi đè biến môi trường
PKGSTEWARD_DATA_DIR="PkgStewardLog"
