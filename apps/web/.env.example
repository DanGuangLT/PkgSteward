# Frontend listen address for pnpm dev / pnpm start.
# Set these in .env.local or .env; real environment variables take precedence.
# Empty values use port 24680 and host 127.0.0.1.
# PORT: integer from 1 to 65535. HOST: 127.0.0.1, localhost or ::1 only.
# When changing PORT/HOST, update the backend's LIST_ORIGIN_CORS to match the frontend origin.
PORT=
HOST=

# Server-only backend URL; do not use the NEXT_PUBLIC_ prefix.
# Must match the backend's HOST and PORT in apps/api/.env.
API_BASE_URL=http://127.0.0.1:24681/api/v1
