# =============================================================================
# Manager NPM Backend Environment Variables
# =============================================================================

# Chế độ chạy: development hoặc production
MODE="development"

# Host và Port chạy local
HOST="localhost"
PORT=8080

# Tiền tố và phiên bản API (URL dạng: http://localhost:8080/api/v1)
GLOBAL_PREFIX="api"
VERSION="1"

# Danh sách Origin được phép truy cập CORS (URL của frontend Next.js)
LIST_ORIGIN_CORS="http://localhost:3000"

# Xuất Swagger API spec ra docs_API/swagger.json khi chạy dev
EXPORT_SWAGGER_API_JSON=true

# Đường dẫn thư mục gốc để scan tìm dự án Node.js/npm (phân cách bằng dấu phẩy nếu nhiều path)
# Ví dụ: "D:\Coding,C:\Users\username\Projects"
SCAN_ROOT_PATHS=""

# Giới hạn độ sâu khi quét cây thư mục
MAX_SCAN_DEPTH=4

# Giới hạn thời gian (ms) khi chạy lệnh npm/pnpm/yarn (mặc định 2 phút)
NPM_COMMAND_TIMEOUT_MS=120000
