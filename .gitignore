# Monorepo Manager NPM — quy tắc chung. Chi tiết từng service nằm trong
# pkgsteward_be/.gitignore và pkgsteward_fe/.gitignore.

# Dependencies
node_modules/

# Build output
dist/
.next/

# Tests & coverage
coverage/
playwright-report/
test-results/

# Env thật — chỉ commit file mẫu
.env
.env.*
!.env.example

# Swagger JSON tự sinh của backend (EXPORT_SWAGGER_API_JSON)
pkgsteward_be/docs_API/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini
