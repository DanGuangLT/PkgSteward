# Monorepo PkgSteward — quy tắc chung. Chi tiết từng service nằm trong
# apps/api/.gitignore và apps/web/.gitignore.

# Dependencies
node_modules/

# Build output
dist/
.next/

# Tests & coverage
coverage/
playwright-report/
test-results/

# Env thật — chỉ commit file mẫu
.env
.env.*
!.env.example

# Swagger JSON tự sinh của backend (EXPORT_SWAGGER_API_JSON)
apps/api/docs_API/

# Logs
logs/
*.log
# Route Handler GET /api/npm-runs/[id]/logs và /api/global-packages/jobs/[id]/logs là mã nguồn, không phải log
!/apps/web/app/api/npm-runs/\[id\]/logs/
!/apps/web/app/api/global-packages/jobs/\[id\]/logs/

# Dữ liệu runtime khi chạy từ mã nguồn (PKGSTEWARD_DATA_DIR mặc định)
/PkgStewardLog/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Lockfiles from a root install with npm, pnpm or Yarn (scripts/install-apps.mjs).
# Each app's pnpm-lock.yaml is the only tracked lockfile.
/package-lock.json
/pnpm-lock.yaml
/yarn.lock
/apps/*/package-lock.json
/apps/*/yarn.lock
